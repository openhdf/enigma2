<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<skin>
	<windowstyle id="1" type="skinned">
		<color color="#000000" name="Background"/>
		<color color="#ffffff" name="LabelForeground"/>
		<color color="#000000" name="ListboxBackground"/>
		<color color="#ffffff" name="ListboxForeground"/>
		<color color="#000000" name="ListboxSelectedBackground"/>
		<color color="#ffffff" name="ListboxSelectedForeground"/>
		<color color="#000000" name="ListboxMarkedBackground"/>
		<color color="#ffffff" name="ListboxMarkedForeground"/>
		<color color="#000000" name="ListboxMarkedAndSelectedBackground"/>
		<color color="#ffffff" name="ListboxMarkedAndSelectedForeground"/>
		<color color="#ffffff" name="WindowTitleForeground"/>
		<color color="#000000" name="WindowTitleBackground"/>
	</windowstyle>
	<fonts>
		<!-- pick a funky name for the font, so we don't conflict  -->
		<font filename="XionHDF/fonts/meteocons.ttf" name="LCDMeteo" scale="90" />
		<font filename="XionHDF/fonts/NotoSans-Bold.ttf" name="LCDRegular" scale="95" />
	</fonts>
<!-- main-->
	<screen name="InfoBarSummary" position="0,0" size="400,240">
		<widget backgroundColor="#001374" position="0,0" size="180,180" source="session.OAWeather" render="Label" font="LCDMeteo;140" foregroundColor="#ffffff" halign="center" valign="center" zPosition="8" transparent="1" >
			<convert type="OAWeather">meteocode,current</convert>
		</widget>
		<widget backgroundColor="#05013E" position="6,170" size="388,58" source="session.OAWeather" render="Label" font="LCDRegular;35" foregroundColor="#ffffff" halign="center" valign="center" zPosition="8" transparent="1">
			<convert type="OAWeather">temperature_text,current</convert>
		</widget>
		<widget backgroundColor="#44004F" position="197,10" size="200,100" source="session.OAWeather" render="Label" font="LCDRegular;70" foregroundColor="#ffffff" halign="right" noWrap="1" zPosition="8" transparent="1">
			<convert type="OAWeather">temperature_high,day1</convert>
		</widget>
		<widget backgroundColor="#44004F" position="197,85" size="200,100" source="session.OAWeather" render="Label" font="LCDRegular;70" foregroundColor="#ffffff" halign="right" noWrap="1" zPosition="8" transparent="1">
			<convert type="OAWeather">temperature_low,day1</convert>
		</widget>
		<ePixmap pixmap="/usr/share/enigma2/display/lcd_skin/weather_lcd.png" position="0,0" size="400,240" zPosition="-9" />
	</screen>
	<include filename="skin_display.xml" />
	<include filename="skin_common.xml" />
</skin>
